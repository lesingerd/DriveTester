<Window x:Class="DriveTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DriveTester"
        xmlns:controls="clr-namespace:DriveTester.Controls"
        xmlns:converters="clr-namespace:DriveTester.Converters"
        xmlns:vm="clr-namespace:DriveTester.ViewModels"
        mc:Ignorable="d"
        Title="DriveTester Pro - Storage Integrity &amp; Multi-Pass Benchmark"
        Icon="app.ico"
        Height="740" Width="1100"
        MinHeight="580" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ShowInTaskbar="True"
        Background="#0b0f19"
        Foreground="#f8fafc">

    <Window.Resources>
        <converters:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <converters:PassedToColorConverter x:Key="PassedToColor" />
        <converters:EnumToDisplayNameConverter x:Key="EnumToName" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Card Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#131d31" />
            <Setter Property="BorderBrush" Value="#1e293b" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Metric Card Style -->
        <Style x:Key="MetricTile" TargetType="Border">
            <Setter Property="Background" Value="#0f172a" />
            <Setter Property="BorderBrush" Value="#1e293b" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="4,0" />
        </Style>

        <!-- Standard Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1e293b" />
            <Setter Property="Foreground" Value="#f8fafc" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#059669" />
            <Setter Property="BorderBrush" Value="#10b981" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10b981" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#991b1b" />
            <Setter Property="BorderBrush" Value="#dc2626" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#dc2626" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Progress Bar -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#0f172a" />
            <Setter Property="BorderBrush" Value="#1e293b" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#38bdf8" />
            <Setter Property="Height" Value="14" />
        </Style>

        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="#1e293b" CornerRadius="0,4,4,0" Margin="0,1,1,1">
                        <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 0 0 L 4 4 L 8 0 Z" Fill="#38bdf8" />
                    </Border>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#38bdf8" />
                    <Setter Property="Background" Value="#172338" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#38bdf8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Border" Property="Opacity" Value="0.5" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBoxItem High Contrast Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#090d16" />
            <Setter Property="Foreground" Value="#f8fafc" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1e3a5f" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0284c7" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Dark Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0b1222" />
            <Setter Property="Foreground" Value="#f8fafc" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource DarkComboBoxToggleButton}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />

                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,4,30,4"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />

                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="280">
                                    <Border Background="#090d16"
                                            BorderBrush="#38bdf8"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,2,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.7" Color="#000000" />
                                        </Border.Effect>
                                        <ScrollViewer Margin="3" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDown" Property="MinHeight" Value="50" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#0f172a" />
            <Setter Property="Foreground" Value="#94a3b8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1e293b" />
                                <Setter Property="Foreground" Value="#38bdf8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header Row -->
            <RowDefinition Height="Auto" />
            <!-- Config & Drive Row -->
            <RowDefinition Height="Auto" />
            <!-- Action Controls Row -->
            <RowDefinition Height="Auto" />
            <!-- Live Telemetry & Speed Dashboard -->
            <RowDefinition Height="Auto" />
            <!-- Bottom Tabs: Logs, Summary, Final Report -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="app.png" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="DriveTester Pro" FontSize="22" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center" />
                    <Border Background="#1e293b" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SSD &amp; Flash Integrity Suite" FontSize="11" Foreground="#94a3b8" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Detect fake flash drives, bad blocks, and thermal throttle via multi-pass file-fill, direct I/O checksum verification, and speed telemetry."
                           FontSize="12" Foreground="#64748b" Margin="0,3,0,0" />
            </StackPanel>

            <!-- Current Phase Badge -->
            <Border Grid.Column="1" Background="{Binding PhaseBadgeBrush}" CornerRadius="16" Padding="14,6" VerticalAlignment="Center">
                <TextBlock Text="{Binding PhaseBadgeText}" FontWeight="Bold" FontSize="12" Foreground="#ffffff" />
            </Border>
        </Grid>

        <!-- 2. Config & Drive Row -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <!-- Drive Selection Card -->
                <ColumnDefinition Width="3*" />
                <!-- Test Configuration Card -->
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- Drive Card -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="TARGET STORAGE DRIVE" FontSize="11" FontWeight="Bold" Foreground="#94a3b8" Margin="0,0,0,8" />

                    <!-- Drive Dropdown & Refresh -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Drives}"
                                  SelectedItem="{Binding SelectedDrive}"
                                  IsEnabled="{Binding CanConfigure}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,3">
                                        <Border Background="#0284c7" CornerRadius="3" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DriveLetter}" FontWeight="Bold" Foreground="#ffffff" FontSize="12" />
                                        </Border>
                                        <TextBlock Text="{Binding DisplayTitle}" Foreground="#f8fafc" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="1" Command="{Binding RefreshDrivesCommand}" Content="↻ Refresh" Margin="6,0,0,0"
                                ToolTip="Refresh drive list" IsEnabled="{Binding CanConfigure}" />
                    </Grid>

                    <!-- Drive Details Card -->
                    <Border Grid.Row="2" Background="#0f172a" CornerRadius="5" Padding="10" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDrive.DetailedSubtitle}" FontSize="12" Foreground="#cbd5e1" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Drive Capacity Utilization:" FontSize="11" Foreground="#64748b" />
                                <TextBlock Grid.Column="1" FontSize="11" Foreground="#94a3b8">
                                    <Run Text="{Binding SelectedDrive.UsedSpaceGB, Mode=OneWay, StringFormat={}{0:F1} GB used}" />
                                    <Run Text=" / " />
                                    <Run Text="{Binding SelectedDrive.TotalSizeGB, Mode=OneWay, StringFormat={}{0:F1} GB total}" />
                                </TextBlock>
                            </Grid>
                            <ProgressBar Value="{Binding SelectedDrive.PercentUsed, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- System Drive Alert Banner -->
                    <Border Grid.Row="3" Background="#450a0a" BorderBrush="#b91c1c" BorderThickness="1" CornerRadius="4" Padding="8,5"
                            Visibility="{Binding IsSystemDriveSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⚠️ System Drive (C:) selected! Ensure you intend to stress this drive."
                                   FontSize="11" Foreground="#fca5a5" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <!-- Test Configuration Card -->
            <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="TEST PARAMETERS &amp; CYCLE SETTINGS" FontSize="11" FontWeight="Bold" Foreground="#94a3b8" Margin="0,0,0,8" />

                    <!-- Grid for settings inputs -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Rounds -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Test Cycles (Rounds):" FontSize="12" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Rounds, UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Left"
                                 Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6,3" IsEnabled="{Binding CanConfigure}" Margin="0,0,16,8" />

                        <!-- Capacity Target -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Capacity Target:" FontSize="12" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <ComboBox Grid.Row="0" Grid.Column="3"
                                  ItemsSource="{Binding TargetModes}"
                                  SelectedItem="{Binding SelectedTargetMode}"
                                  IsEnabled="{Binding CanConfigure}" Margin="0,0,0,8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToName}}" Foreground="#f8fafc" FontSize="13" Margin="2,2" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- File Size Profile -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="File Size Mix:" FontSize="12" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding SizePresets}"
                                  SelectedItem="{Binding SelectedPreset}"
                                  IsEnabled="{Binding CanConfigure}" Margin="0,0,16,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToName}}" Foreground="#f8fafc" FontSize="13" Margin="2,2" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Custom GB (if chosen) -->
                        <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                                    Visibility="{Binding IsCustomCapacityVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Custom GB:" FontSize="12" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding CustomCapacityGB, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                     Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Padding="6,3" IsEnabled="{Binding CanConfigure}" />
                        </StackPanel>
                    </Grid>

                    <!-- Advanced Flags & Summary -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <WrapPanel>
                            <CheckBox Content="Direct Write-Through (bypass RAM cache)" IsChecked="{Binding FlushBuffersDirectly}"
                                      Foreground="#cbd5e1" FontSize="12" Margin="0,0,16,4" IsEnabled="{Binding CanConfigure}" />
                            <CheckBox Content="Empty test files after each round" IsChecked="{Binding EmptyFilesAfterEachRound}"
                                      Foreground="#cbd5e1" FontSize="12" Margin="0,0,16,4" IsEnabled="{Binding CanConfigure}" />
                            <CheckBox Content="Stop on first corrupt block" IsChecked="{Binding StopOnFirstError}"
                                      Foreground="#cbd5e1" FontSize="12" Margin="0,0,16,4" IsEnabled="{Binding CanConfigure}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding TargetCapacityCalculationText}" FontSize="11" Foreground="#38bdf8" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Action Controls & Recovery Row -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <!-- Interrupted Session Recovery Banner -->
            <Border Visibility="{Binding HasResumableSession, Converter={StaticResource BoolToVis}}"
                    Background="#3b1b05" BorderBrush="#f59e0b" BorderThickness="1" CornerRadius="6"
                    Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠️ " FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ResumableSessionBanner}" Foreground="#fef3c7" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text=" — Incomplete file will be recreated" Foreground="#fde68a" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding ResumeTestCommand}" Content="↻ Resume Test" Background="#d97706" BorderBrush="#b45309" Foreground="#ffffff" FontWeight="Bold" Padding="12,4" Margin="0,0,8,0" />
                        <Button Command="{Binding DiscardSessionCommand}" Content="Discard Session" Background="#292524" BorderBrush="#44403c" Foreground="#d6d3d1" Padding="10,4" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardPanel}" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding StartTestCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="18,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▶  START INTEGRITY TEST" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Command="{Binding PauseResumeCommand}" Content="{Binding PauseResumeButtonText}" Margin="0,0,8,0" Padding="14,8" />

                <Button Grid.Column="2" Command="{Binding StopTestCommand}" Content="⏹ Stop Test" Style="{StaticResource DangerButton}" Margin="0,0,14,0" Padding="14,8" />

                <Button Grid.Column="3" Command="{Binding CleanTestFilesCommand}" Content="🧹 Clean Leftover Files" Margin="0,0,8,0"
                        ToolTip="Delete orphaned test folders from previously interrupted runs" />

                <Button Grid.Column="4" Command="{Binding ExportReportCommand}" Content="📄 Export Report" Margin="0,0,8,0"
                        ToolTip="Export diagnostic report as HTML or Markdown" />

                <TextBlock Grid.Column="5" Text="{Binding StatusMessage}" FontSize="12" Foreground="#94a3b8"
                           VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </StackPanel>

        <!-- 4. Live Telemetry & Speed Dashboard -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <!-- KPI Tiles -->
                <RowDefinition Height="Auto" />
                <!-- Dual Progress Bars -->
                <RowDefinition Height="Auto" />
                <!-- Speed Sparkline Graph -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 5 KPI Tiles -->
            <UniformGrid Grid.Row="0" Columns="5" Margin="-4,0,-4,10">
                <!-- Tile 1: Current Speed -->
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="CURRENT SPEED" FontSize="10" FontWeight="Bold" Foreground="#64748b" />
                        <TextBlock Text="{Binding CurrentSpeedDisplay}" FontSize="20" FontWeight="Bold" Foreground="#38bdf8" Margin="0,2,0,0" />
                        <TextBlock Text="Instantaneous Rate" FontSize="10" Foreground="#64748b" />
                    </StackPanel>
                </Border>

                <!-- Tile 2: Avg / Peak -->
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="AVERAGE / PEAK" FontSize="10" FontWeight="Bold" Foreground="#64748b" />
                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="#f8fafc" Margin="0,2,0,0">
                            <Run Text="{Binding AvgSpeedDisplay, Mode=OneWay}" />
                            <Run Text=" / " FontSize="12" Foreground="#64748b" />
                            <Run Text="{Binding PeakSpeedDisplay, Mode=OneWay}" FontSize="13" Foreground="#a7f3d0" />
                        </TextBlock>
                        <TextBlock Text="Phase Throughput" FontSize="10" Foreground="#64748b" />
                    </StackPanel>
                </Border>

                <!-- Tile 3: Processed Data -->
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="DATA PROCESSED" FontSize="10" FontWeight="Bold" Foreground="#64748b" />
                        <TextBlock Text="{Binding ProcessedSizeDisplay}" FontSize="15" FontWeight="Bold" Foreground="#f8fafc" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding CurrentRoundDisplay}" FontSize="10" Foreground="#38bdf8" />
                    </StackPanel>
                </Border>

                <!-- Tile 4: Elapsed & ETA -->
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="ELAPSED / ETA" FontSize="10" FontWeight="Bold" Foreground="#64748b" />
                        <TextBlock FontSize="15" FontWeight="Bold" Foreground="#f8fafc" Margin="0,2,0,0">
                            <Run Text="{Binding ElapsedTimeDisplay, Mode=OneWay}" />
                            <Run Text=" | " FontSize="11" Foreground="#64748b" />
                            <Run Text="{Binding EtaDisplay, Mode=OneWay}" Foreground="#38bdf8" />
                        </TextBlock>
                        <TextBlock Text="Estimated remaining" FontSize="10" Foreground="#64748b" />
                    </StackPanel>
                </Border>

                <!-- Tile 5: Error Counter -->
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="INTEGRITY STATUS" FontSize="10" FontWeight="Bold" Foreground="#64748b" />
                        <TextBlock Text="{Binding ErrorBadgeText}" FontSize="13" FontWeight="Bold" Foreground="{Binding ErrorBadgeBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Bit-for-bit checksum" FontSize="10" Foreground="#64748b" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Dual Progress Bars -->
            <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="14,10" Margin="0,0,0,10">
                <StackPanel>
                    <!-- Overall Progress -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="11" Foreground="#94a3b8" FontWeight="SemiBold">
                            <Run Text="Overall Test Progress: " />
                            <Run Text="{Binding CurrentRoundDisplay, Mode=OneWay}" Foreground="#38bdf8" />
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding OverallProgressPercent, StringFormat={}{0:F1}%}" FontSize="11" Foreground="#38bdf8" FontWeight="Bold" />
                    </Grid>
                    <ProgressBar Value="{Binding OverallProgressPercent}" Maximum="100" Height="10" Margin="0,0,0,8" />

                    <!-- Phase & File Progress -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="11" Foreground="#94a3b8" TextTrimming="CharacterEllipsis">
                            <Run Text="Current File: " />
                            <Run Text="{Binding CurrentFileDisplay, Mode=OneWay}" Foreground="#f1f5f9" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding FileProgressPercent, StringFormat={}{0:F1}%}" FontSize="11" Foreground="#a7f3d0" FontWeight="Bold" />
                    </Grid>
                    <ProgressBar Value="{Binding FileProgressPercent}" Maximum="100" Height="6" Foreground="#10b981" />
                </StackPanel>
            </Border>

            <!-- Real-Time Speed Graph -->
            <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="10" Height="90">
                <Grid>
                    <controls:SpeedGraphControl x:Name="LiveSpeedGraph" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <TextBlock Text="REAL-TIME THROUGHPUT (MB/s)" FontSize="10" FontWeight="Bold" Foreground="#475569"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,4,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- 5. Bottom Tabs: Activity Log, Rounds Summary Table, Diagnostic Report -->
        <TabControl Grid.Row="4" Background="#131d31" BorderBrush="#1e293b" BorderThickness="1">
            <!-- Tab 1: Live Event Log -->
            <TabItem Header="Activity Log">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Detailed test execution timeline &amp; verification events" FontSize="12" Foreground="#64748b" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox x:Name="AutoScrollCheckbox" Content="Auto-scroll" IsChecked="True" Foreground="#94a3b8" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <Button Command="{Binding ClearLogsCommand}" Content="Clear Log" Padding="8,3" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <ListBox Grid.Row="1" x:Name="LogListBox" ItemsSource="{Binding Logs}" Background="#0a0f1d" BorderBrush="#1e293b"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Standard"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="[" Foreground="#475569" FontSize="12" FontFamily="Consolas" />
                                    <TextBlock Text="{Binding TimeFormatted}" Foreground="#64748b" FontSize="12" FontFamily="Consolas" />
                                    <TextBlock Text="] " Foreground="#475569" FontSize="12" FontFamily="Consolas" />
                                    <TextBlock Text="{Binding Message}" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- Tab 2: Rounds Summary -->
            <TabItem Header="Rounds Summary">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Per-round data throughput, write/read speeds, and error statistics" FontSize="12" Foreground="#64748b" Margin="0,0,0,8" />

                    <DataGrid Grid.Row="1" ItemsSource="{Binding RoundResults}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#0a0f1d" RowBackground="#0f172a" AlternatingRowBackground="#131e33"
                              Foreground="#f8fafc" BorderBrush="#1e293b" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1e293b"
                              HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1e293b" />
                                <Setter Property="Foreground" Value="#94a3b8" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Round #" Binding="{Binding RoundNumber}" Width="70" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusBadge}" Width="90" />
                            <DataGridTextColumn Header="Data Written" Binding="{Binding WrittenGB, StringFormat={}{0:F2} GB}" Width="110" />
                            <DataGridTextColumn Header="Avg Write Speed" Binding="{Binding AvgWriteSpeedMBps, StringFormat={}{0:F1} MB/s}" Width="130" />
                            <DataGridTextColumn Header="Peak Write Speed" Binding="{Binding PeakWriteSpeedMBps, StringFormat={}{0:F1} MB/s}" Width="130" />
                            <DataGridTextColumn Header="Data Verified" Binding="{Binding VerifiedGB, StringFormat={}{0:F2} GB}" Width="110" />
                            <DataGridTextColumn Header="Avg Read Speed" Binding="{Binding AvgReadSpeedMBps, StringFormat={}{0:F1} MB/s}" Width="130" />
                            <DataGridTextColumn Header="Peak Read Speed" Binding="{Binding PeakReadSpeedMBps, StringFormat={}{0:F1} MB/s}" Width="130" />
                            <DataGridTextColumn Header="Duration" Binding="{Binding TotalRoundDuration, StringFormat={}{0:mm\\:ss}}" Width="90" />
                            <DataGridTextColumn Header="Errors" Binding="{Binding ErrorCount}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 3: Final Diagnostics & Report -->
            <TabItem Header="Final Diagnostic Report">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Overall Drive Assessment &amp; Integrity Audit" FontSize="12" Foreground="#64748b" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CopyReportCommand}" Content="📋 Copy Markdown" Margin="0,0,8,0" Padding="8,3" FontSize="11" />
                            <Button Command="{Binding ExportReportCommand}" Content="💾 Save HTML / Markdown" Padding="8,3" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <TextBox Grid.Row="1" Text="{Binding ReportMarkdown}" IsReadOnly="True"
                             Background="#0a0f1d" Foreground="#e2e8f0" BorderBrush="#1e293b"
                             FontFamily="Consolas" FontSize="12" Padding="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
